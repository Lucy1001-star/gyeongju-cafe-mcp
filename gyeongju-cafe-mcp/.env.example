# 이 파일을 .env 로 복사한 뒤 발급받은 키를 넣으세요. (.env 는 절대 공유하지 마세요)

# 카카오 개발자 사이트 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 공공데이터포털 > 마이페이지 > 경주시 전망 좋은 카페 현황 > 일반 인증키 (Encoding/Decoding 아무거나)
DATA_GO_KR_SERVICE_KEY=

# (선택) Google Cloud > Places API (New) 키. 넣으면 요일별 영업시간이 함께 나옵니다.
GOOGLE_PLACES_API_KEY=
